COHERE_API_KEY="<API-KEY>"
BUCKET_NAME = "<NOMBRE_BUCKET>"
FAST_API_BUCKET= "localhost" #localhost
DISCORD_WEBHOOK_URL = "<DISCORD_WEBHOOK_URL>"
SLACK_WEBHOOK_URL = "<SLACK_WEBHOOK_URL>"
# MongoDB (opcional: sin MONGO_URI la app funciona solo con el bucket)
# Sin autenticación (mongod solo en 127.0.0.1):
MONGO_URI=mongodb://127.0.0.1:27017/
# Con autenticación: MONGO_URI=mongodb://<user>:<pass>@127.0.0.1:27017/insightmind
MONGO_DB=insightmind
GITHUB_TOKEN='<GITHUB_TOKEN>'
TWITTER_API_KEY='<TWITTER_API_KEY>'
TWITTER_API_SECRET='<TWITTER_API_SECRET>'
TWITTER_ACCESS_TOKEN='<TWITTER_ACCESS_TOKEN>'
TWITTER_ACCESS_TOKEN_SECRET='<TWITTER_ACCESS_TOKEN_SECRET>'
LINKEDIN_CLIENT_ID='<LINKEDIN_CLIENT_ID>'
LINKEDIN_CLIENT_SECRET='<LINKEDIN_CLIENT_SECRET>'
LINKEDIN_ACCESS_TOKEN='<LINKEDIN_ACCESS_TOKEN>'
LINKEDIN_ORG_ID='<LINKEDIN_ORG_ID>'
# --- Autenticación (backend/auth.py) ---
# AUTH_SECRET lo genera `python -m backend.auth crear <usuario>` si no existe. Cambiarlo cierra todas las sesiones.
AUTH_SECRET=
AUTH_USERS_FILE=data/usuarios.json
AUTH_SESSION_HOURS=12
# false mientras accedas por http://localhost; true solo si algún día pones HTTPS
AUTH_COOKIE_SECURE=false
# Opcionales (desarrollo sin nginx)
# SERVIR_UI=1                       # FastAPI sirve el front en /ui
# CORS_ORIGINS=http://localhost:5500
SLACK_BOT_TOKEN=xoxb-TU_TOKEN_REAL
SLACK_CHANNEL_ID=XXXXXXXXXXXXXXXX
# Texto que se muestra en el front como nombre del canal (el ID real no se expone). Por defecto: Canal-slack
SLACK_CHANNEL_LABEL=Canal-slack
