    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1ba3687f-a3cb-473c-ab85-33e87182c7f6",
              "name": "prompt",
              "value": "=Analiza el siguiente texto.  Devuelve únicamente un JSON válido:  {   \"sentimiento\":\"POSITIVO|NEUTRAL|NEGATIVO\",   \"tematica\":\"tema principal\",   \"resumen\":\"resumen breve\" }  Texto: {{ $json.data.interaccion.texto }}  ",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        64,
        -576
      ],
      "id": "21a96e42-7f20-4fd0-a153-53e4bc10b7c7",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.cohere.ai/v2/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer <API KEY>"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"command-r-08-2024\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.prompt) }}\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        496,
        -576
      ],
      "id": "e3c47337-87d4-451a-87dd-64ae575b9d90",
      "name": "HTTP Request2"
    },
    {
      "parameters": {
        "maxItems": 10
      },
