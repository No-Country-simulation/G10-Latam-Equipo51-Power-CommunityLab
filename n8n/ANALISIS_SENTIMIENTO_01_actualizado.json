      "typeVersion": 1,
      "position": [
        288,
        -576
      ],
      "id": "fa63be67-3035-4da7-873e-c861aed5138b",
      "name": "Limit"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "procesar-lote",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -832,
        -432
      ],
      "id": "0b9e0053-c2bb-410d-9298-1d412fa39c4b",
      "name": "Webhook"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const resp = $json;\nlet raw = resp.message?.content?.[0]?.text || \"\";\nraw = raw.replace(/```json|```/g, \"\").trim();\n\nlet ia;\ntry { ia = JSON.parse(raw); }\ncatch (e) { ia = { sentimiento: \"NEUTRAL\", tematica: \"sin_tema\", resumen: raw.slice(0,120) }; }\n\nconst original = $('Edit Fields').item.json;\n\nreturn {\n  json: {\n    autor: original.data?.interaccion?.autor ?? null,\n    texto: original.data?.interaccion?.texto ?? null,\n    mensaje_entrada: original.data?.interaccion?.texto ?? null,\n    respuesta_ia: raw,\n    sentimiento: ia.sentimiento,\n    tematica: ia.tematica,\n    resumen: ia.resumen\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -576
      ],
      "id": "f89992e8-fedd-49db-b2d3-23fbd8708bd7",
      "name": "Interpretar respuesta IA"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\nconst contar = s => items.filter(m => m.sentimiento === s).length;\n\nreturn [{\n  json: {\n    total: items.length,\n    positivo: contar(\"POSITIVO\"),\n    neutral: contar(\"NEUTRAL\"),\n    negativo: contar(\"NEGATIVO\"),\n    mensajes: items\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        -576
      ],
      "id": "234893b9-d480-4659-b390-b13e0c42855e",
      "name": "Consolidar sentimiento"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
